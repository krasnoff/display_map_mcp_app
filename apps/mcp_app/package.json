{
  "name": "@workspace/mcp_app",
  "version": "1.0.0",
  "description": "A React and TypeScript MCP App template",
  "private": true,
  "main": "dist-server/mcp.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env mcp.ts",
    "build:ui": "vite build",
    "generate:html": "tsx scripts/generate-html.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm build:ui && pnpm generate:html && pnpm build:server",
    "serve": "node --env-file-if-exists=.env dist-server/mcp.js",
    "start": "tsx --env-file-if-exists=.env mcp.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@hono/mcp": "^0.3.2",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@workspace/ui": "workspace:*",
    "hono": "^4.13.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
