{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "mcp.ts",
    "http.ts",
    "geocode.ts",
    "osrm-provider.ts",
    "server.ts",
    "api/**/*.ts",
    "generated/**/*.ts"
  ]
}
